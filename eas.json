{
  "cli": {
    "version": ">=3.0.0"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "GOOGLE_SERVICES_JSON"
      },
      "prebuildCommand": "echo $GOOGLE_SERVICES_JSON | base64 -d > android/app/google-services.json"
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "GOOGLE_SERVICES_JSON"
      },
      "prebuildCommand": "echo $GOOGLE_SERVICES_JSON | base64 -d > android/app/google-services.json"
    }
  }
}
