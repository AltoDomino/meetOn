{
  "expo": {
    "name": "meetOn",
    "slug": "meetOn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/startMeetOn.png",
    "scheme": "meeton",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/startMeetOn.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1a4d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domino96.meetOn",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Aplikacja potrzebuje Twojej lokalizacji, aby pokazać wydarzenia w pobliżu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/startMeetOn.png",
        "backgroundColor": "#0d1a4d"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.domino96.meetOn",
      "googleServicesFile": "./google-services.json",
      "permissions": ["NOTIFICATIONS", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/startMeetOn.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/startMeetOn.png",
          "color": "#0d1a4d"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-web-browser",
      "react-native-edge-to-edge"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21c25dfa-afc4-4d4a-9ce3-3d1a809d4dfe"
      }
    },
    "owner": "domino96"
  }
}
