{
  "expo": {
    "name": "meetOn",
    "slug": "meetOn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/startMeetOn.png",
    "scheme": "meeton",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/startMeetOn.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1a4d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domino96.meetOn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/startMeetOn.png",
        "backgroundColor": "#0d1a4d"
      },
      "edgeToEdgeEnabled": true,
      "useNextNotificationsApi": true,
      "package": "com.domino96.meetOn"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/startMeetOn.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21c25dfa-afc4-4d4a-9ce3-3d1a809d4dfe"
      }
    },
    "owner": "domino96"
  }
}
