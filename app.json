{
  "expo": {
    "name": "meetOn",
    "slug": "meetOn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ikonkameeton.png",
    "scheme": "meeton",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/startMeetOn.png",
      "resizeMode": "cover",
      "backgroundColor": "#01032f"
    },
    "android": {
      "package": "com.domino96.meetOn",
      "versionCode": 6,
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ikonkameeton.png",
        "backgroundColor": "#01032f"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": ["NOTIFICATIONS", "ACCESS_FINE_LOCATION"],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "meeton" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domino96.meetOn",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Aplikacja potrzebuje Twojej lokalizacji, aby pokazać wydarzenia w pobliżu."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/startMeetOn.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/powiadomienie-meeton.png",
          "color": "#0d1a4d"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "googleServicesFile": "./android/app/google-services.json"
          }
        }
      ],
      "expo-web-browser",
      "react-native-edge-to-edge"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21c25dfa-afc4-4d4a-9ce3-3d1a809d4dfe"
      }
    },
    "owner": "domino96"
  }
}
